<div class="mx-auto max-w-lg">
  <div class="card">
    <h1 class="font-display text-2xl">Create your account</h1>
    <p class="mt-1 text-sm text-slate-500">You need an account to add spots, comments, and likes.</p>

    <%= form_with model: @user, url: registrations_path, class: "mt-6 space-y-4" do |form| %>
      <div>
        <%= form.label :email, class: "label" %>
        <%= form.email_field :email, class: "input" %>
      </div>
      <div>
        <%= form.label :password, class: "label" %>
        <%= form.password_field :password, class: "input" %>
      </div>
      <div>
        <%= form.label :password_confirmation, class: "label" %>
        <%= form.password_field :password_confirmation, class: "input" %>
      </div>
      <%= form.submit "Create account", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
