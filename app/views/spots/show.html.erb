<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="font-display text-3xl"><%= @spot.name %></h1>
    <p class="mt-1 text-sm text-slate-500"><%= @spot.city %>, <%= @spot.state %> · <%= @spot.status.capitalize %></p>
  </div>
  <div class="flex gap-2">
    <% if policy(@spot).update? %>
      <%= link_to "Edit", edit_spot_path(@spot), class: "btn-secondary" %>
    <% end %>
  </div>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-[2fr,1fr]">
  <section class="card">
    <h2 class="font-display text-xl">About this spot</h2>
    <p class="mt-3 text-sm text-slate-600"><%= @spot.description.presence || "No description yet." %></p>
  </section>

  <aside class="card space-y-4">
    <div>
      <p class="text-xs uppercase tracking-wide text-slate-400">Status</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= @spot.status.capitalize %></p>
    </div>
    <div>
      <p class="text-xs uppercase tracking-wide text-slate-400">Likes</p>
      <p class="mt-1 text-sm font-semibold text-slate-700"><%= @spot.likes.count %></p>
      <% if current_user %>
        <% if @like %>
          <%= button_to "Unlike", spot_like_path(@spot, @like), method: :delete, class: "btn-secondary mt-3" %>
        <% else %>
          <%= button_to "Like", spot_likes_path(@spot), class: "btn-primary mt-3" %>
        <% end %>
      <% else %>
        <%= link_to "Log in to like", new_session_path, class: "btn-secondary mt-3" %>
      <% end %>
    </div>
  </aside>
</div>

<section class="mt-10">
  <div class="flex items-center justify-between">
    <h2 class="font-display text-2xl">Comments</h2>
    <p class="text-sm text-slate-500"><%= @spot.comments.count %> total</p>
  </div>

  <div class="mt-4 space-y-4">
    <% @spot.comments.order(created_at: :desc).each do |comment| %>
      <div class="card">
        <p class="text-sm text-slate-600"><%= comment.body %></p>
        <p class="mt-2 text-xs text-slate-400">by <%= comment.user.email %></p>
      </div>
    <% end %>
  </div>

  <div class="mt-6 card">
    <h3 class="font-display text-lg">Add a comment</h3>
    <% if current_user %>
      <%= form_with model: [@spot, @comment], class: "mt-4 space-y-4" do |form| %>
        <div>
          <%= form.label :body, "Comment", class: "label" %>
          <%= form.text_area :body, rows: 3, class: "input" %>
        </div>
        <%= form.submit "Post comment", class: "btn-primary" %>
      <% end %>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">Log in to join the conversation.</p>
    <% end %>
  </div>
</section>
