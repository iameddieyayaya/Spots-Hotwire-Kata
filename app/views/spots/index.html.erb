<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="font-display text-3xl">Discover Spots</h1>
    <p class="mt-1 text-sm text-slate-500">Practice Hotwire patterns with a clean, focused UI.</p>
  </div>
  <% if current_user %>
    <%= link_to "New spot", new_spot_path, class: "btn-primary" %>
  <% else %>
    <%= link_to "Log in to add a spot", new_session_path, class: "btn-primary" %>
  <% end %>
</div>

<div class="mt-6 card" data-controller="toggle">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <%= form_with url: spots_path, method: :get, class: "flex flex-wrap items-center gap-3" do |form| %>
      <%= form.label :query, "Search", class: "label" %>
      <%= form.search_field :query, value: params[:query], placeholder: "Search by name or city", class: "input" %>
      <%= form.submit "Search", class: "btn-secondary" %>
    <% end %>
    <button class="btn-secondary" data-action="toggle#swap">Filters</button>
  </div>

  <div class="mt-4 hidden" data-toggle-target="panel">
    <%= form_with url: spots_path, method: :get, class: "grid gap-4 md:grid-cols-3" do |form| %>
      <div>
        <%= form.label :status, class: "label" %>
        <%= form.select :status, options_for_select(Spot::STATUSES, params[:status]), { include_blank: "Any status" }, class: "input" %>
      </div>
      <div>
        <%= form.label :state, class: "label" %>
        <%= form.text_field :state, value: params[:state], placeholder: "State (e.g. WA)", class: "input" %>
      </div>
      <div class="flex items-end gap-2">
        <%= form.submit "Apply filters", class: "btn-primary" %>
        <%= link_to "Reset", spots_path, class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-8 grid gap-6 md:grid-cols-2">
  <% @spots.each do |spot| %>
    <article class="card">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="font-display text-xl">
            <%= link_to spot.name, spot_path(spot), class: "hover:underline" %>
          </h2>
          <p class="mt-1 text-sm text-slate-500"><%= spot.city %>, <%= spot.state %> · <%= spot.status.capitalize %></p>
        </div>
      </div>
      <p class="mt-4 text-sm text-slate-600"><%= spot.description.presence || "No description yet." %></p>
    </article>
  <% end %>
</div>

<div class="mt-6">
  <%= pagy_nav(@pagy) if @pagy %>
</div>
